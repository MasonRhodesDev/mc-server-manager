# Copy to .env (gitignored) and fill in real values. Used by docker-compose.prod.yml.
# Host directory holding the manager database.
CONFIG_DIR=/srv/mc-server-manager/config
# Host directories for server data and backups (mounted at the same path in the container).
DATA_PATH=/srv/minecraft
BACKUPS_PATH=/srv/minecraft-backups
# Public URL of the manager UI.
FRONTEND_URL=https://mcm.example.com
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Deployment helpers referenced in the docker-compose.prod.yml header.
DEPLOY_USER=deploy
DEPLOY_HOST=192.0.2.10
